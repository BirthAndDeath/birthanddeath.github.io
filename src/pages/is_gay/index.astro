---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { getProject, getReadmeHtml, getRepoMeta, projectJsonLd } from "../../lib/projects.mjs";

const project = getProject("is_gay");
const [readmeHtml, meta] = await Promise.all([
  project.readme === false ? Promise.resolve("") : getReadmeHtml(project),
  getRepoMeta(project),
]);
---
<BaseLayout
  title={project.title}
  description={project.description}
  mainClass="detail"
  jsonLd={projectJsonLd(project)}
>
  <ProjectLayout project={project} readmeHtml={readmeHtml} meta={meta} />
</BaseLayout>
